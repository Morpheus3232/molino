# Molino Environment Variables
# Copy to .env.local for local development
# Configure in Vercel: Project Settings → Environment Variables

# ============================================================
# AI PROVIDERS
# ============================================================

# OpenAI API Key (required for OpenAI provider)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic/Claude API Key (required for Claude provider)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API Key (optional; for the 'openrouter' provider)
# Get from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: Override default models
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Provider routing configuration
# Primary provider to use ('openai' | 'claude' | 'openrouter' | 'omniroute')
AI_PRIMARY_PROVIDER=omniroute
# Fallback provider if primary fails ('openai' | 'claude' | 'openrouter' | 'omniroute')
AI_FALLBACK_PROVIDER=openrouter
# Enable automatic fallback on failure (true | false)
AI_ENABLE_FALLBACK=true

# Optional: Free tier rate limiting & retry configuration
# Max retries per provider on rate limit (default: 2)
AI_MAX_RETRIES=2
# Delay between retries in ms (default: 1000)
AI_RETRY_DELAY_MS=1000

# Feature flag: route buildIntelligencePrompt through the extracted
# lib/engines/intelligence/promptBuilder.ts (V2) instead of the legacy
# switch still kept in intelligenceEngine.ts. Default false — flip to
# 'true' only after prompt-builder-content.test.ts is confirmed green on
# both paths; set back to 'false' for an instant rollback, no redeploy.
INTELLIGENCE_ENGINE_V2_ENABLED=false

# OpenAI free tier limits (adjust based on your plan)
OPENAI_FREE_RPM=3
OPENAI_FREE_TPM=40000

# Anthropic/Claude free tier limits (adjust based on your plan)
ANTHROPIC_FREE_RPM=5
ANTHROPIC_FREE_TPM=40000

# OpenRouter free tier limits (adjust based on your plan)
OPENROUTER_FREE_RPM=20
OPENROUTER_FREE_TPM=40000

# OmniRoute free tier limits (adjust based on your plan)
OMNIROUTE_FREE_RPM=60
OMNIROUTE_FREE_TPM=200000

# OmniRoute Configuration
# Base URL for OmniRoute proxy (default: http://localhost:20128 — no /v1 suffix,
# the code appends it). OmniRoute is a LOCAL proxy: it only exists on the dev
# machine. In production (Vercel) there is no localhost proxy, so the router
# automatically skips OmniRoute (isOmniRouteConfigured() checks VERCEL/NODE_ENV)
# and falls through to the real provider. Only set this to a remote URL if you
# host the OmniRoute proxy somewhere reachable from production.
# OMNIROUTE_BASE_URL=http://localhost:20128
# Recommended for production using your funded OpenRouter account:
# AI_PRIMARY_PROVIDER=openrouter
# AI_FALLBACK_PROVIDER=openai
# Comma-separated list of preferred models (overrides default fallback chain)
# OMNIROUTE_PREFERRED_MODELS=omniroute/z-ai/glm-4.7-flash-free,omniroute/auto/best-free
# Enable health checks for OmniRoute models (default: true)
# OMNIROUTE_HEALTH_CHECK=true
# Health check interval in ms (default: 60000)
# OMNIROUTE_HEALTH_CHECK_INTERVAL=60000

# ============================================================
# REQUIRED FOR PRODUCTION PAYMENTS
# ============================================================

# Base URL for return/cancel/back URLs (NO trailing slash)
# Production: https://tudominio.com
# Preview: https://tudominio-git-branch.vercel.app
# Local: http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://tudominio.com

# ============================================================
# MERCADO PAGO
# ============================================================

# Access token from Mercado Pago Developer Dashboard
# Production: APP_USR-xxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxxxxxxxxxx
# Sandbox: TEST-xxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxxxxxxxxxx
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxxxxxxxxxx

# Webhook secret from Mercado Pago Dashboard → Notificaciones Webhook
MP_WEBHOOK_SECRET=your_webhook_secret_here

# Pepper dedicado para hashProfile() (perfil→hash de acceso Premium).
# Opcional: si no se define, se usa MP_WEBHOOK_SECRET (comportamiento actual).
# Definila aparte en producción para poder rotar el secreto del webhook de
# Mercado Pago sin invalidar los hashes de perfil ya emitidos.
PROFILE_HASH_SECRET=your_profile_hash_pepper_here

# Secret used to sign ephemeral profile-share JWTs (lib/share.ts).
# Falls back to MP_WEBHOOK_SECRET for dev; set a distinct value in prod.
SHARE_SECRET=your_share_secret_here

# ============================================================
# PREMIUM DISPLAY / FEATURE FLAGS
# ============================================================

# Enable Premium features (gate, CTA, etc.)
NEXT_PUBLIC_PREMIUM_ENABLED=true

# Enable Mercado Pago button
NEXT_PUBLIC_MERCADOPAGO_ENABLED=true

# Display price in USD (for UI only; checkout price is in lib/mercadopago.ts)
NEXT_PUBLIC_PREMIUM_PRICE_USD=8

# ============================================================
# KV / DATABASE (Vercel KV / Upstash Redis)
# ============================================================

# KV REST API URL (auto-configured by Vercel when adding KV integration)
# KV_REST_API_URL=https://...

# KV REST API Token (auto-configured by Vercel when adding KV integration)
# KV_REST_API_TOKEN=...

# ============================================================
# COUPON (Production only - not for local dev)
# ============================================================

# PREMIUM_COUPON=VALEN

# ============================================================
# OPTIONAL: Analytics / Monitoring
# ============================================================

# POSTHOG_KEY=...
# SENTRY_DSN=...